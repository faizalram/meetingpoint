# Server key: Places API (New) + Routes API. Only used on the server.
GOOGLE_MAPS_API_KEY=

# Browser key: Maps JavaScript API only, restricted to your Vercel website.
# Sent to the browser at runtime by /api/config to draw the map.
GOOGLE_MAPS_BROWSER_KEY=

# Optional: a Map ID from Google Cloud > Map Management. DEMO_MAP_ID is used if empty.
GOOGLE_MAP_ID=
